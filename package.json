{
  "name": "openear",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @openear/shared",
    "dev": "npm run dev -w @openear/web",
    "dev:api": "npm run dev -w @openear/api",
    "build": "npm run build -w @openear/shared && npm run build -w @openear/web",
    "lint": "npm run lint -w @openear/web",
    "type-check": "npm run type-check --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @openear/api"
  },
  "engines": {
    "node": ">=20"
  }
}
