# Open Ear: local development settings. Copy to `.env` in the repo root (it is gitignored).
# Both the API (apps/api) and the website (apps/web) read this one file.
# Only variables starting with VITE_ are ever exposed to the browser. Never prefix a secret with VITE_.
# In production, set these in the Render (API) and Vercel (website) dashboards instead.

# ---------------------------------------------------------------- Website (Vite)
# Leave empty: Vite's dev server (and Vercel in production) proxy /api to the API.
VITE_API_URL=
VITE_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- API
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Public URL of the API itself (used for local file links). Local dev: same as CLIENT_URL.
PUBLIC_API_URL=http://localhost:3000

# Neon Postgres (Dashboard → Connect). Use the POOLED string (host contains "-pooler") for the app,
# and the direct string for migrations. Set sslmode=verify-full on both.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
DB_POOL_MAX=10
# Tests only (npm test). They WIPE this database, and refuse to run unless its name contains "test".
# Use a Neon branch database named e.g. openear_test, or a local Postgres.
TEST_DATABASE_URL=

# At least 32 random characters in production. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

RESEND_API_KEY=
EMAIL_FROM=Open Ear <noreply@openearemedy.com>
ADMIN_EMAIL=

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Cloudflare R2. Leave ALL empty to store uploads on local disk (apps/api/uploads).
#   R2_PUBLIC_BUCKET  covers (enable public access, set R2_PUBLIC_URL to its r2.dev or custom domain)
#   R2_PRIVATE_BUCKET ebook files (keep private; downloads use 5-minute signed URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

# Calls: Cloudflare TURN relay (Dashboard → Realtime → TURN keys). Required in production;
# without it, local dev uses direct connections so two browser tabs can still call each other.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Website: where the browser opens the call WebSocket. Production: wss://api.openearemedy.com/ws
# (Vercel can't proxy WebSockets). Leave empty locally; the dev server proxies /ws.
VITE_WS_URL=

# Being replaced: Groq → OpenRouter (stage 6).
GROQ_API_KEY=

TRUST_PROXY=1
