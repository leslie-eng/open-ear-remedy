# Frontend (Vite). Rebuild after changing.
# Production on Vercel: leave VITE_API_URL empty. Vercel rewrites /api/* to the Render API (same origin).
VITE_API_URL=
VITE_SITE_URL=https://openearemedy.com

# Local dev: leave VITE_API_URL empty too; the Vite dev server proxies /api to http://localhost:3001.
