PORT=3001
NODE_ENV=production

# Use lowercase postgresql:// — not PostgreSQL://
# If password contains @ # % & etc., URL-encode it (@ → %40)
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME

# REQUIRED: at least 32 random characters, or the API refuses to start in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_URL=https://openearemedy.com
CORS_ORIGINS=https://openearemedy.com,https://www.openearemedy.com

RESEND_API_KEY=
EMAIL_FROM=Open Ear <noreply@openearemedy.com>

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=USD

GROQ_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

ADMIN_EMAIL=

# Optional: restrict outbound calls to these dialing prefixes (comma list), e.g. +233,+234,+1
CALL_ALLOWED_PREFIXES=
# Longest call allowed, in minutes (also capped by the user's credits)
CALL_MAX_MINUTES=60
# One-time free trial credits per verified account
FREE_TRIAL_CREDITS=50

# Only if the API runs on a different domain than CLIENT_URL (e.g. Render): its public URL
PUBLIC_API_URL=
# Number of proxies in front of Node (LiteSpeed/Apache on cPanel = 1)
TRUST_PROXY=1

# cPanel: /home2/openeare/server/uploads
# Render: leave default (./uploads) — disk is ephemeral on free tier
UPLOAD_DIR=./uploads
