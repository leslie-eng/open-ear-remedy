<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # REQUIRED for production: proxy /api and /uploads to your cPanel Node app.
  # In Setup Node.js App, copy the port shown for openear/server and replace 3001 below.
  # These rules MUST stay above the SPA fallback rules.
  RewriteCond %{REQUEST_URI} ^/api [OR]
  RewriteCond %{REQUEST_URI} ^/uploads
  RewriteRule ^(.*)$ http://127.0.0.1:3001/$1 [P,L]

  # Never serve source maps, archives or dotfiles
  RewriteRule \.(map|zip)$ - [F,L]
  RewriteRule (^|/)\. - [F,L]

  # React Router — serve index.html for client routes
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self)"

  # Hashed build assets can be cached forever; index.html must always be fresh.
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

Options -Indexes
